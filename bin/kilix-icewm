#!/usr/bin/env python3
"""Kilix IceWM desktop provider.

Runs IceWM on a private X display owned by ``kilix_sdk.xapp`` and presents it
in the Kilix pane, with IceWM's own menu and toolbar generated from the Kilix
content catalog so the desktop and the host agree about what is installed.

Selection is the same as any other provider::

    kilix icewm

Design notes worth knowing before changing this file:

* The private display, capture, RandR refit and XTest input injection all live
  in the SDK. This provider supplies configuration and supervision only.
* The IceWM configuration directory is private and rewritten every launch.
  IceWM never sees, and can never write, the operator's ``~/.icewm``.
* IceWM is LGPL-2.0 and stays in its own submodule under its own licence. It is
  built, not vendored, precisely so that boundary stays visible.
"""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(_HERE), "src"))

from kilix_icewm.menu import (  # noqa: E402
    build_menu_model,
    escape_label,
    render_menu,
    render_toolbar,
)
from kilix_icewm.session import (  # noqa: E402
    IceWMConfig,
    resolve_icewm,
)

REQUIRED_SDK = "1.10"


def _add_sdk_path() -> str:
    """Put the host's ``kilix_sdk`` on the path.

    KILIX_HOME is exported by the launcher for providers; the sibling-checkout
    fallback keeps a standalone `./bin/kilix-icewm` working for development.
    """
    home = os.environ.get("KILIX_HOME")
    candidates = []
    if home:
        candidates.append(os.path.join(home, "config"))
    src = os.environ.get("GPU_TERMINAL_SOURCE_HOME",
                         os.path.expanduser("~/.local/gpu_terminal/sources"))
    candidates.append(os.path.join(src, "kilix", "config"))
    candidates.append(os.path.join(os.path.dirname(os.path.dirname(_HERE)),
                                   "..", "kilix", "config"))
    for path in candidates:
        if os.path.isdir(os.path.join(path, "kilix_sdk")):
            sys.path.insert(0, path)
            return path
    sys.exit("kilix-icewm: cannot find kilix_sdk; run this through `kilix icewm`")


def _catalog_records(sdk_content, kilix_cmd: str) -> list:
    """Enumerate the catalog. Every record, its own label, its own kind.

    ``Catalog`` is iterable and each ``ContentSpec`` already carries ``label``,
    ``kind`` and ``icon``, so nothing here is hardcoded: catalog content added
    upstream appears in this menu without touching this file. A provider-side
    ID table would only be a copy that drifts.

    A catalog that cannot be read costs the Games/Applications sections and
    nothing else -- the terminal row is unconditional, so the user always has a
    way to act.
    """
    if sdk_content is None:
        return []
    try:
        records = sdk_content.menu_records()
    except Exception:
        return []
    rendered = []
    for rec in records:
        item = {
            "id": rec["id"],
            "name": rec["label"],
            "kind": rec["kind"],
            "icon": rec["icon"] or "-",
            # Installed state is the host's business: `kilix run` installs on
            # first use, so every known record is offered as a launch row and
            # the host decides whether that means "start" or "fetch first".
            "installed": True,
        }
        if rec["kind"] == "app":
            try:
                plan = sdk_content.application_plan(
                    rec["id"], "window", launcher=kilix_cmd)
            except Exception:
                continue
            item["command"] = list(plan.argv)
        rendered.append(item)
    return rendered


def _xdg_records(sdk_xdgapps) -> list:
    if sdk_xdgapps is None:
        return []
    for attr in ("applications", "discover", "list_applications"):
        fn = getattr(sdk_xdgapps, attr, None)
        if callable(fn):
            try:
                return list(fn() or [])
            except Exception:
                return []
    return []


def write_config(root: str, *, kilix_cmd: str, terminal: str,
                 wallpaper: str | None = None) -> str:
    """Generate IceWM's private configuration for this launch."""
    try:
        from kilix_sdk import content as sdk_content
    except Exception:
        sdk_content = None
    try:
        from kilix_sdk import xdgapps as sdk_xdgapps
    except Exception:
        sdk_xdgapps = None

    model = build_menu_model(
        catalog=_catalog_records(sdk_content, kilix_cmd),
        xdg_apps=_xdg_records(sdk_xdgapps),
        kilix_cmd=kilix_cmd,
    )
    cfg = IceWMConfig(root)
    cfg.write({
        "menu": render_menu(model, kilix_cmd=kilix_cmd, terminal=terminal),
        "toolbar": render_toolbar(model, kilix_cmd=kilix_cmd, terminal=terminal),
        "preferences": _render_preferences(wallpaper),
    })
    return cfg.root


# Chosen for a captured, keyboard-driven pane rather than a physical desktop:
# one static wallpaper, no animations that would turn every frame into damage,
# and a taskbar that stays put.
PREFERENCES = """\
# Generated by kilix-icewm. Edits are overwritten on next launch.
TaskBarAutoHide=0
TaskBarShowClock=1
TaskBarShowAllWindows=1
ShowMoveSizeStatus=0
QuickSwitch=1
DesktopBackgroundColor="rgb:20/20/28"
UseRootPixmap=0
Animations=0
MenuMouseTracking=1
WorkspaceNames=" 1 ", " 2 ", " 3 ", " 4 "
"""


def _render_preferences(wallpaper: str | None = None) -> str:
    """Return preferences with an optional, safely quoted static wallpaper."""
    if not wallpaper:
        return PREFERENCES
    image = escape_label(os.path.abspath(wallpaper))
    return PREFERENCES + (
        "DesktopBackgroundCenter=0\n"
        "DesktopBackgroundScaled=1\n"
        f'DesktopBackgroundImage="{image}"\n'
    )


def _default_wallpaper(prefix: str) -> str | None:
    """Use a wallpaper shipped by the pinned IceWM build, if available."""
    share = os.path.join(prefix, "share", "icewm")
    candidates = (
        os.path.join(share, "themes", "NanoBlue", "eos.jpg"),
        os.path.join(share, "IceWM.jpg"),
    )
    return next((path for path in candidates if os.path.isfile(path)), None)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="kilix-icewm", add_help=True)
    parser.add_argument("--version", action="store_true",
                        help="print the provider version and exit")
    parser.add_argument("--check", action="store_true",
                        help="verify the SDK, config generation and IceWM "
                             "binary without starting a display")
    parser.add_argument("--print-config", action="store_true",
                        help="write the generated IceWM config and print its path")
    args = parser.parse_args(argv)

    version_file = os.path.join(os.path.dirname(_HERE), "VERSION")
    try:
        version = open(version_file, encoding="utf-8").read().strip()
    except OSError:
        version = "unknown"
    if args.version:
        print(version)
        return 0

    _add_sdk_path()
    try:
        from kilix_sdk import require_compatible
        require_compatible(REQUIRED_SDK)
    except ImportError:
        return _fail("kilix_sdk is not importable; update the Kilix checkout")
    except Exception as exc:
        return _fail(f"incompatible Kilix SDK: {exc}")

    storage = os.environ.get(
        "KILIX_ICEWM_STORAGE_HOME",
        os.path.expanduser("~/.local/gpu_terminal/kilix-icewm"))
    kilix_cmd = os.environ.get("KILIX_COMMAND", "kilix")
    terminal = os.environ.get("KILIX_TERMINAL", kilix_cmd)
    config_root = os.path.join(storage, "config", "icewm")
    prefix = os.environ.get("KILIX_ICEWM_PREFIX", os.path.join(storage, "prefix"))
    wallpaper = _default_wallpaper(prefix)

    if args.print_config:
        print(write_config(
            config_root, kilix_cmd=kilix_cmd, terminal=terminal,
            wallpaper=wallpaper))
        return 0

    session_bin, wm_bin = resolve_icewm(prefix)
    binary = session_bin or wm_bin

    if args.check:
        write_config(
            config_root, kilix_cmd=kilix_cmd, terminal=terminal,
            wallpaper=wallpaper)
        print(f"kilix-icewm {version}")
        print(f"  config:  {config_root}")
        print(f"  icewm:   {binary or 'NOT BUILT (run scripts/build-icewm.sh)'}")
        return 0 if binary else 1

    if not binary:
        return _fail("IceWM is not built yet; run scripts/build-icewm.sh "
                     "(the Kilix launcher does this on first selection)")

    write_config(
        config_root, kilix_cmd=kilix_cmd, terminal=terminal,
        wallpaper=wallpaper)
    return _run_desktop(binary, config_root)


def _run_desktop(binary: str, config_root: str) -> int:
    """Present the configured IceWM session through Kilix's X-app runner.

    The desktop launcher has already created the destination tab and set
    ``KILIX_IN_OVERLAY``.  Calling ``kilix run`` here therefore stays in that
    tab and supplies the complete host presentation loop: private Xvfb,
    damage capture, Kitty graphics, resize handling, input injection and
    process cleanup.

    IceWM is the window manager for this display, so the generic runner's
    optional top-level-window refit must stay disabled.  Resizing IceWM's
    clients behind its back would destroy the layout it is responsible for.
    """
    runner = _resolve_kilix_runner()
    if runner is None:
        return _fail("cannot find the Kilix app runner; run this through "
                     "`kilix icewm` or set KILIX_HOME")

    env = IceWMConfig(config_root).env_for()
    env["KILIX_RUN_AUTO_FIT"] = "0"
    env["KILIX_NO_PANE"] = "0"
    # IceWM resolves every ``prog`` command while parsing menu/toolbar files
    # and silently drops rows whose executable is not on PATH.  The host's
    # presentation runner intentionally starts with a small PATH, which need
    # not contain either the source-checkout ``kilix`` launcher or this
    # private IceWM prefix.  Keep both executable directories visible so the
    # generated catalog survives parsing and icewm-session can start helpers
    # such as icewmbg.
    executable_dirs = [os.path.dirname(runner), os.path.dirname(binary)]
    old_path = env.get("PATH", "")
    env["PATH"] = os.pathsep.join(
        [*dict.fromkeys(path for path in executable_dirs if path), old_path]
    ).rstrip(os.pathsep)
    command = [runner, "run", "--fill", "--desktop-session", binary]
    try:
        completed = subprocess.run(command, env=env, check=False)
    except OSError as exc:
        return _fail(f"could not start the Kilix app runner: {exc}")
    return completed.returncode


def _resolve_kilix_runner() -> str | None:
    """Return an executable host launcher without evaluating shell text."""
    candidates = []
    home = os.environ.get("KILIX_HOME")
    if home:
        candidates.append(os.path.join(home, "kilix"))

    command = os.environ.get("KILIX_COMMAND", "kilix")
    if os.path.sep in command:
        candidates.append(os.path.abspath(os.path.expanduser(command)))
    else:
        found = shutil.which(command)
        if found:
            candidates.append(found)

    # Development fallback for gpu_terminal/kilix-desktops/kilix-icewm next
    # to gpu_terminal/kilix. Installed providers normally use KILIX_HOME.
    candidates.append(os.path.abspath(os.path.join(
        os.path.dirname(os.path.dirname(_HERE)), "..", "kilix", "kilix")))
    for candidate in candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _fail(message: str) -> int:
    print(f"kilix-icewm: {message}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
